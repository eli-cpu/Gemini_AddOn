{
  "manifest_version": 3,
  "name": "Gemini AddOn",
  "description": "Organisiert Gemini- und ChatGPT-Chats in Ordnern – per Drag & Drop, manuell oder per KI.",
  "version": "1.0.0",
  "action": {
    "default_title": "Gemini AddOn",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://gemini.googleusercontent.com/*",
    "https://chatgpt.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://gemini.googleusercontent.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "autoFolderInit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
