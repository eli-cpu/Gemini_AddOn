{
  "manifest_version": 3,
  "name": "Gemini AddOn",
  "description": "Organisiert Gemini-Chats in Ordnern – per Drag & Drop oder automatisch per KI.",
  "version": "1.0.0",
  "action": {
    "default_title": "Gemini AddOn",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://gemini.googleusercontent.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://gemini.googleusercontent.com/*"
      ],
      "js": ["autoFolderInit.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
