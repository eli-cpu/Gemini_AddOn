# Optional developer config. Copy to .env (same folder). Never commit .env.
# The extension itself does NOT use GEMINI_API_KEY – users enter their key
# in the popup ("KI aktivieren"). It is only read by frontend/src/scripts/testAPI.js.
GEMINI_API_KEY=

# Optional build-time model override – defaults to gemini-flash-lite-latest
GEMINI_MODEL=
